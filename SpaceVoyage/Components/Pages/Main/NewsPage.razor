@page "/news-{pageNumber}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SpaceVoyage.Data
@inject IDbContextFactory<PatchnoteDataContext> PatchnoteDataContextFactory;
@inject NavigationManager NavigationManager



<div class="container text-center">
    <div class="FAQtext">
        <div class="list-group">
            @if (PatchnotesList != null)
            {
                int numOfCycles = 0;

                for (int i = pageNumberInt * 10; i < numOfPatchnotes; i++)
                {
                    if (numOfCycles < 10)
                    {
                        var patchnote = PatchnotesList.ElementAt(i);
                        <div class="showPatchnotesList">
                            <a class="list-group-item list-group-item-action patchnote" href="/news/patchnote-@patchnote.Id">
                                <span>@patchnote.Title</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        break;
                    }
                    numOfCycles++;
                }
            }


            <div class="container">
                <nav aria-label="Page navigation example">
                    <ul class="pagination">
                        @if (pageNumberInt > 1) {
                            <li class="page-item"><a class="page-link" href="/news-@(pageNumberInt-1)">Previous</a></li>
                        } else {
                            <li class="page-item"><a class="page-link" href="/news">Previous</a></li>
                        }
                        <li class="page-item"><a class="page-link" href="/news">1</a></li>
                        @for (int i = 0; i < numOfPages-1; i++)
                        {
                            int pageNumber = i + 1;
                            <li class="page-item"><a class="page-link" href="/news-@pageNumber">@(pageNumber + 1)</a></li>
                        }

                        @if (pageNumberInt + 1 < numOfPages)
                        {
                            <li class="page-item"><a class="page-link" href="/news-@(pageNumberInt+1)">Next</a></li>
                        } else {
                            @if (pageNumberInt > 0)
                            {
                                <li class="page-item"><a class="page-link" href="/news-@(pageNumberInt)">Previous</a></li>
                            }
                            else
                            {
                                <li class="page-item"><a class="page-link" href="/news">Previous</a></li>
                            }
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>