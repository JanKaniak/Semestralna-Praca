@using Microsoft.AspNetCore.Authorization
@page "/news"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SpaceVoyage.Data
@inject IDbContextFactory<DatabaseContext> PatchnoteDataContextFactory;
@inject NavigationManager NavigationManager
@inject ILogger<News> Logger
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>News</PageTitle>

@if (CreateShowForm)
{
    <div class="container">
        <div class="list-group">
            <EditForm Model="@NewPatchnote" OnValidSubmit="CreateNewPatchnote">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label for="exampleFormControlInput1" class="form-label">Patchnote Title</label>
                    <InputText type="text" class="form-control" id="titleForm" @bind-value="NewPatchnote.Title" />
                    <ValidationMessage For="() => NewPatchnote.Title" class="errorMessages"></ValidationMessage>
                </div>

                <div class="mb-3">
                    <label for="exampleFormControlTextarea1" class="form-label">Example textarea</label>
                    <InputTextArea class="form-control" id="descriptionForm" rows="10" @bind-value="NewPatchnote.Description" />
                    <ValidationMessage For="() => NewPatchnote.Description" class="errorMessages"></ValidationMessage>
                </div>

                <InputFile OnChange="LoadFile" />

                <div class="mb-3">
                    <div id="Error" class="form-text">
                        <p style="color:red">@ErrorMessage</p>
                    </div>
                </div>
                <button type="submit" class="nbt btn btn-danger">Create</button>
                <button type="button" class="nbt btn btn-danger" onclick="Return">Back</button>
            </EditForm>
        </div>
    </div>


}
else
{
    <div class="news">
        <div>
            @if (PatchnotesList != null)
            {
                <div class="site-header">
                    <h1>Patchnotes</h1>

                </div>

                int numOfCycles = 0;
                <div class="list-group">
                    @if (!EditShowForm && !ShowPatchnote)
                    {
                        <div class="showPatchnotesList">
                            <AuthorizeView Roles="Administrator">
                                <button type="button" class="btn btn-danger" @onclick="ShowCreateForm">Create</button>
                            </AuthorizeView>
                        </div>




                        <div class="container">
                            <nav aria-label="Page navigation example">
                                <ul class="pagination">
                                    <li class="page-item"><a class="page-link" href="/news">Previous</a></li>
                                    <li class="page-item"><a class="page-link" href="/news">1</a></li>
                                    @for (int j = 0; j < numOfPages - 1; j++)
                                    {
                                        int pageNumber = j + 1;
                                        <li class="page-item"><a class="page-link" href="/news-@pageNumber">@(pageNumber + 1)</a></li>
                                    }
                                    @if (currentPageNumber + 1 <= numOfPages)
                                    {
                                        <li class="page-item"><a class="page-link" href="/news-@(currentPageNumber+1)">Next</a></li>
                                    }
                                    else
                                    {
                                        @if (currentPageNumber > 0)
                                        {
                                            <li class="page-item"><a class="page-link" href="/news-@(currentPageNumber)">Previous</a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item"><a class="page-link" href="/news">Previous</a></li>
                                        }
                                    }
                                </ul>
                            </nav>
                        </div>
                    }

                    @for (int i = currentPageNumber; i < numOfPatchnotes; i++)
                    {
                        var patchnote = PatchnotesList.ElementAt(i);
                        if (numOfCycles < 10)
                        {
                            @if (!EditShowForm && !ShowPatchnote)
                            {
                                if (patchnote.Type == "patchnote")
                                {
                                    <div class="container">
                                        <div class="patchnote">
                                            <div align="left">
                                                <a href="/news/patchnote-@patchnote.Id" style="overflow: hidden;display: inline-block;">
                                                    @patchnote.Title
                                                </a>
                                            </div>
                                            <div align="right">
                                                @patchnote.ReleaseDate
                                            </div>
                                        </div>

                                        <AuthorizeView Roles="Administrator">
                                            <div class="adminButtonsEditRemove" role="group" aria-label="Basic example">
                                                <button class="btn btn-danger btn-sm" @onclick="() => ShowEditForm(patchnote)">Edit</button>
                                                <button class="btn btn-danger btn-sm" @onclick="() => RemovePatchnote(patchnote)">Remove</button>
                                            </div>
                                        </AuthorizeView>
                                    </div>
                                }
                                

                            }
                            else if (EditShowForm && !ShowPatchnote)
                            {
                                @if (PatchnoteToUpdate != null && PatchnoteToUpdate.Id == patchnote.Id)
                                {
                                    <EditForm Model="@PatchnoteToUpdate" OnValidSubmit="UpdatePatchnote">
                                        <DataAnnotationsValidator />
                                        <div class="mb-3">
                                            <label for="exampleFormControlInput1" class="form-label">Patchnote Title</label>
                                            <InputText type="text" class="form-control" id="titleForm" @bind-value="patchnote.Title" />
                                            <ValidationMessage For="() => patchnote.Title" class="errorMessages"></ValidationMessage>

                                        </div>

                                        <div class="mb-3">
                                            <label for="exampleFormControlTextarea1" class="form-label">Example textarea</label>
                                            <InputTextArea class="form-control" id="descriptionForm" rows="10" @bind-value="patchnote.Description" />
                                            <ValidationMessage For="() => patchnote.Description" class="errorMessages"></ValidationMessage>
                                        </div>

                                        @code {
                                            bool imageUploaded = false;
                                        }
                                        @if (!string.IsNullOrWhiteSpace(patchnote.FilePath))
                                        {
                                            <img src="@patchnote.FilePath" style="max-width: 50%; max-height: 50%" />
                                            <button type="button" class="nbt btn btn-danger" @onclick="() => RemoveImage(patchnote)">Remove</button>
                                            imageUploaded = true;
                                        }
                                        <InputFile OnChange="LoadFile" disabled="@imageUploaded" />

                                        <div class="mb-3">
                                            <div id="Error" class="form-text">@ErrorMessage</div>
                                        </div>
                                        <button type="submit" class="nbt btn btn-danger">Update</button>
                                        <button type="button" class="nbt btn btn-danger" onclick="@Return">Back</button>
                                    </EditForm>
                                }
                            }
                        }
                        else
                        {
                            break;
                        }
                        numOfCycles++;
                    }

                    @if (!EditShowForm && !ShowPatchnote)
                    {
                        
                    }
                </div>
            }
        </div>
    </div>
}
