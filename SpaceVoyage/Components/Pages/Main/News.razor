@using Microsoft.AspNetCore.Authorization
@page "/news"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SpaceVoyage.Data
@inject IDbContextFactory<DatabaseContext> PatchnoteDataContextFactory;
@inject NavigationManager NavigationManager
@inject ILogger<News> Logger
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>News</PageTitle>


    <div class="news">
        <div>
            @if (PatchnotesList != null)
            {
                <div class="site-header">
                    <h1>Patchnotes</h1>

                </div>

                int numOfCycles = 0;
                <div class="list-group">
                    @if (!EditShowForm && !ShowPatchnote)
                    {
                        <div class="showPatchnotesList">
                            <AuthorizeView Roles="Administrator">
                                <button type="button" class="btn btn-danger" @onclick="() => OpenPageCreateNewPatchnote(Type)">Create</button>
                            </AuthorizeView>
                        </div>




                        <div class="container">
                            <nav aria-label="Page navigation example">
                                <ul class="pagination">
                                    <li class="page-item"><a class="page-link" href="/news">Previous</a></li>
                                    <li class="page-item"><a class="page-link" href="/news">1</a></li>
                                    @for (int j = 0; j < numOfPages - 1; j++)
                                    {
                                        int pageNumber = j + 1;
                                        <li class="page-item"><a class="page-link" href="/news-@pageNumber">@(pageNumber + 1)</a></li>
                                    }
                                    @if (currentPageNumber + 1 <= numOfPages)
                                    {
                                        <li class="page-item"><a class="page-link" href="/news-@(currentPageNumber+1)">Next</a></li>
                                    }
                                    else
                                    {
                                        @if (currentPageNumber > 0)
                                        {
                                            <li class="page-item"><a class="page-link" href="/news-@(currentPageNumber)">Previous</a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item"><a class="page-link" href="/news">Previous</a></li>
                                        }
                                    }
                                </ul>
                            </nav>
                        </div>
                    }

                    @for (int i = currentPageNumber; i < numOfPatchnotes; i++)
                    {
                        var patchnote = PatchnotesList.ElementAt(i);
                        if (numOfCycles < 10)
                        {
                            @if (!EditShowForm && !ShowPatchnote)
                            {
                                if (patchnote.Type == "patchnote")
                                {
                                    <div class="container">
                                        <div class="patchnote">
                                            <div align="left">
                                                <a href="/news/patchnote-@patchnote.Id" style="overflow: hidden;display: inline-block;">
                                                    @patchnote.Title
                                                </a>
                                            </div>
                                            <div align="right">
                                                @patchnote.ReleaseDate
                                            </div>
                                        </div>

                                        <AuthorizeView Roles="Administrator">
                                            <div class="adminButtonsEditRemove" role="group" aria-label="Basic example">
                                                <button class="btn btn-danger btn-sm" @onclick="() => OpenPage(patchnote)">Edit</button>
                                                <button class="btn btn-danger btn-sm" @onclick="() => RemovePatchnote(patchnote)">Remove</button>
                                            </div>
                                        </AuthorizeView>
                                    </div>
                                }
                                

                            }
                            
                        }
                        else
                        {
                            break;
                        }
                        numOfCycles++;
                    }

                    @if (!EditShowForm && !ShowPatchnote)
                    {
                        
                    }
                </div>
            }
        </div>
    </div>
