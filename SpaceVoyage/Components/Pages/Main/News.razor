@page "/news"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SpaceVoyage.Data
@inject IDbContextFactory<PatchnoteDataContext> PatchnoteDataContextFactory;
@inject NavigationManager NavigationManager

<PageTitle>News</PageTitle>

@if(CreateShowForm) {
    <div class="container">
        <div class="list-group">
            <EditForm Model="@NewPatchnote" OnValidSubmit="CreateNewPatchnote">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label for="exampleFormControlInput1" class="form-label">Patchnote Title</label>
                    <InputText type="text" class="form-control" id="titleForm" @bind-value="NewPatchnote.Title"/>
                        <ValidationMessage For="() => NewPatchnote.Title" class="errorMessages"></ValidationMessage>
                        <ValidationMessage For="() => NewPatchnote.testovaciStlpec" class="errorMessages"></ValidationMessage>
                </div>

                <div class="mb-3">
                    <label for="exampleFormControlTextarea1" class="form-label">Example textarea</label>
                    <InputTextArea class="form-control" id="descriptionForm" rows="10" @bind-value="NewPatchnote.Description"/>
                        <ValidationMessage For="() => NewPatchnote.Description" class="errorMessages"></ValidationMessage>
                </div>
        
                <InputNumber type="number" class="form-control" id="neviemuz" @bind-Value="NewPatchnote.testovaciStlpec" />
                    <ValidationMessage For="() => NewPatchnote.testovaciStlpec" class="errorMessages"></ValidationMessage>
        
                    <div class="mb-3">
                        <div id="Error" class="form-text">@ErrorMessage</div>
                    </div>
                    <button type="submit" class="nbt btn btn-danger">Create</button>
                    <button type="button" class="nbt btn btn-danger" onclick="@Return">Back</button>
            </EditForm>
        </div>
    </div>
    
    
} else {
    <div class="container text-center">
        <div class="FAQtext">
            @if (PatchnotesList != null && PatchnotesList.Count > 0)
            {
                <div class="list-group">
                        @if (!EditShowForm && !ShowPatchnote)
                        {
                                    <p>Patch notes</p>
                                    <div class="showPatchnotesList">
                                        <AuthorizeView Roles="Administrator">
                                            <button type="button" class="btn btn-danger" @onclick="ShowCreateForm">Create</button>
                                        </AuthorizeView>
                                    </div>
                        }
                        @foreach (var patchnote in PatchnotesList)
                        {
                            @if (!EditShowForm && !ShowPatchnote)
                            {
                                    <div class="showPatchnotesList">
                                    <a class="list-group-item list-group-item-action patchnote" @onclick="() => ShowSelectedPatchnote(patchnote)">
                                        <span>@patchnote.Title</span>
                                    </a>
                                        <AuthorizeView Roles="Administrator">
                                            <div class="adminButtonsEditRemove" role="group" aria-label="Basic example">
                                                <button class="btn btn-danger btn-sm" @onclick="() => ShowEditForm(patchnote)">Edit</button>
                                                <button class="btn btn-danger btn-sm" @onclick="() => RemovePatchnote(patchnote)">Remove</button>
                                            </div>
                                        </AuthorizeView>
                                     </div>
                            

                            }
                        else if (EditShowForm && !ShowPatchnote)
                        {
                             @if (PatchnoteToUpdate != null && PatchnoteToUpdate.Id == patchnote.Id)
                                {
                                <EditForm Model="@PatchnoteToUpdate" OnValidSubmit="UpdatePatchnote">
                                    <DataAnnotationsValidator />
                                    <div class="mb-3">
                                        <label for="exampleFormControlInput1" class="form-label">Patchnote Title</label>
                                        <InputText type="text" class="form-control" id="titleForm" @bind-value="patchnote.Title" />
                                        <ValidationMessage For="() => patchnote.Title" class="errorMessages"></ValidationMessage>
                                        
                                    </div>

                                    <div class="mb-3">
                                        <label for="exampleFormControlTextarea1" class="form-label">Example textarea</label>
                                        <InputTextArea class="form-control" id="descriptionForm" rows="10" @bind-value="patchnote.Description" />
                                        <ValidationMessage For="() => patchnote.Description" class="errorMessages"></ValidationMessage>
                                    </div>

                                    <InputNumber type="number" class="form-control" id="neviemuz" @bind-Value="patchnote.testovaciStlpec" />
                                    <ValidationMessage For="() => patchnote.testovaciStlpec" class="errorMessages"></ValidationMessage>
                                    <div class="mb-3">
                                        <div id="Error" class="form-text">@ErrorMessage</div>
                                    </div>
                                    <button type="submit" class="nbt btn btn-danger">Create</button>
                                    <button type="button" class="nbt btn btn-danger" onclick="@Return">Back</button>
                                </EditForm>
                             }
                        } else if (!EditShowForm && ShowPatchnote){
                            if (PatchnoteToShow != null && PatchnoteToShow.Id == patchnote.Id) {
                                <pre>@PatchnoteToShow.Title</pre>
                                <pre>@PatchnoteToShow.ReleaseDate</pre>
                                <div align="left">
                                    <pre>@PatchnoteToShow.Description</pre>
                                </div>
                                @if (PatchnoteToShow.testovaciStlpec != null) {
                                    <pre>@PatchnoteToShow.testovaciStlpec</pre>
                                }
                                <button type="button" class="nbt btn btn-danger" @onclick="Return">Return</button>
                            }
                        }
                    }
                </div>
            }
        </div>
    </div>
}
