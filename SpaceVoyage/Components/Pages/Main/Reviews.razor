@using Microsoft.AspNetCore.Authorization
@page "/reviews"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SpaceVoyage.Data
@inject IDbContextFactory<DatabaseContext> PatchnoteDataContextFactory;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<Reviews> Logger
@inject IJSRuntime JS


<div class="review-grid">
    <div class="site-header">
        <h1>REVIEWS</h1>
    </div>


    <div class="review-column-positive-header">
        <p>Positive reviews</p>
    </div>
    <div class="review-column-positive">
        @foreach (var review in ReviewsList)
        {
            if (review.Rating > 3)
            {
                <div class="user-review">
                    <div class="review-header">
                        <pre><strong>@review.Header</strong></pre>
                    </div>

                    <div class="review-date">
                        <pre>@review.ReleaseDate</pre>
                    </div>

                    <div class="review-user-name">
                        @UserName = @UserList.Find(x => x.UserId == review.UserId).UserName;
                        <pre><strong>@UserName</strong></pre>
                    </div>

                    <div class="review-rating">
                        <pre>@review.Rating</pre>
                    </div>

                    <div class="review-text">
                        <pre>@review.Text</pre>
                    </div>
                </div>
            }

            <AuthorizeView Roles="User,Administrator">
                <div class="revier-button">
                    <a href="#">Edit</a>
                    <a href="#">Remove</a>
                </div>
            </AuthorizeView>
        }
       

        
            
        
    </div>
    <div class="review-column-middle-header">
        <p>Neutral reviews</p>
    </div>
    <div class="review-column-negative-header">
        <p>Negative reviews</p>
    </div>
</div>