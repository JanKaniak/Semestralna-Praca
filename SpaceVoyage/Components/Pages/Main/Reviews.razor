@using Microsoft.AspNetCore.Authorization
@page "/reviews"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SpaceVoyage.Data
@inject IDbContextFactory<DatabaseContext> PatchnoteDataContextFactory;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<Reviews> Logger
@inject IJSRuntime JS


<div class="review-container">
    <div class="site-header">
        <h1>REVIEWS</h1>
    </div>
    <div class="review-grid">
        <AuthorizeView Roles="User, Administrator">
            <div class="revier-button">
                <a href="/reviews/create-forum">Create Review</a>
            </div>
        </AuthorizeView>

        <div class="review-column-positive-header" align="center">
            <p><strong>Positive reviews</strong></p>
        </div>
        <div class="review-column-positive">
            @if (ReviewsList.Count == 0)
            {
                <div class="user-review">
                    <p>No review has been created</p>
                </div>
            }
            else
            {

                @foreach (var review in ReviewsList)
                {
                    if (review.Rating > 3)
                    {
                        <div class="user-review">
                            <div class="review-left-side">
                                <div align="center">
                                    @if (UserList.Find(x => x.UserId == review.UserId) != null) {
                                        <pre><strong>@UserList.Find(x => x.UserId == review.UserId).Name</strong></pre>
                                        
                                    } else {
                                        <pre><strong>Unknown User</strong></pre>
                                    }
                                    <pre>@review.ReleaseDate</pre>
                                </div>
                            </div>

                            <div class="review-right-side">
                                <pre><strong>@review.Header</strong></pre>

                                @for (int i = 0; i < @review.Rating; i++)
                                {
                                    <span>⭐</span>
                                }

                                <pre style="margin-top: 1rem;">@review.Text</pre>
                            </div>

                            <AuthorizeView Roles="User,Administrator">
                                @if (CreatedReview(review))
                                {
                                    <div class="revier-button">
                                        <a href="#">Edit</a>
                                        <a href="#">Remove</a>
                                    </div>
                                }
                            </AuthorizeView>
                        </div>
                    }


                }

            }
        </div>

        <div class="review-column-negative-header" align="center">
            <p><strong>Negative reviews</strong></p>
        </div>

        <div class="review-column-negative">
            @if (ReviewsList.Count == 0)
            {
                <div class="user-review">
                    <p>No review has been created</p>
                </div>
            }
            else
            {

                @foreach (var review in ReviewsList)
                {
                    if (review.Rating <= 3)
                    {
                        <div class="user-review">


                            <div class="review-left-side">
                                <div align="center">
                                    @if (UserList.Find(x => x.UserId == review.UserId) != null)
                                    {
                                        <pre><strong>@UserList.Find(x => x.UserId == review.UserId).Name</strong></pre>

                                    }
                                    else
                                    {
                                        <pre><strong>Unknown User</strong></pre>
                                    }
                                    <pre>@review.ReleaseDate</pre>
                                </div>
                            </div>

                            <div class="review-right-side">
                                <pre><strong>@review.Header</strong></pre>





                                @for (int i = 0; i < @review.Rating; i++)
                                {
                                    <span>⭐</span>
                                }
                                <pre style="margin-top: 1rem;">@review.Text</pre>

                                
                            </div>


                                <AuthorizeView Roles="User,Administrator">
                                    @if (CreatedReview(review))
                                    {
                                        <div class="revier-button">
                                            <a href="#">Edit</a>
                                            <a href="#">Remove</a>
                                        </div>
                                    }
                                </AuthorizeView>
                        </div>



                        
                    }


                }

            }
        </div>
    </div>
</div>