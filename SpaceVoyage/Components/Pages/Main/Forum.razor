@page "/forum"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SpaceVoyage.Data
@inject IDbContextFactory<DatabaseContext> PatchnoteDataContextFactory;
@inject NavigationManager NavigationManager
@inject ILogger<News> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>News</PageTitle>


    <div class="news">

        <div class="site-header">
            <h1>FORUM</h1>
            <h6>Please be respectful to everyone. Any criticism or other disinformation about game will be deleted.</h6>

        </div>
        @if (PostsList != null)
        {
            int numOfCycles = 0;
            <div class="list-group" align="left">
                @if (!EditShowForm && !ShowPost)
                {
                    <div class="showPatchnotesList">
                        <AuthorizeView Roles="Administrator, User">
                            <button type="button" class="btn btn-danger" @onclick="() => OpenPageCreateNewPost(Type)">Create</button>
                        </AuthorizeView>
                    </div>




                    <div class="container">
                        <nav aria-label="Page navigation example">
                            <ul class="pagination">
                                <li class="page-item"><a class="page-link" href="/news">Previous</a></li>
                                <li class="page-item"><a class="page-link" href="/news">1</a></li>
                                @for (int j = 0; j < numOfPages - 1; j++)
                                {
                                    int pageNumber = j + 1;
                                    <li class="page-item"><a class="page-link" href="/forum-@pageNumber">@(pageNumber + 1)</a></li>
                                
                                @if (currentPageNumber + 1 <= numOfPages)
                                {
                                <li class="page-item"><a class="page-link" href="/forum-@(currentPageNumber+1)">Next</a></li>
                                }
                                else
                                {
                                    @if (currentPageNumber > 0)
                                    {
                                    <li class="page-item"><a class="page-link" href="/forum-@(currentPageNumber)">Previous</a></li>
                                    }
                                    else
                                    {
                                    <li class="page-item"><a class="page-link" href="/forum">Previous</a></li>
                                    }
                                }
                            }
                            </ul>
                        </nav>
                    </div>
                }

                @for (int i = currentPageNumber; i < numOfPosts; i++)
                {
                    var forumPost = PostsList.ElementAt(i);
                    if (numOfCycles < 10)
                    {
                        @if (!EditShowForm && !ShowPost)
                        {
                            if (forumPost.Type == "forum")
                            {
                                <div class="container">
                                    <div class="patchnote">
                                        <div align="left">
                                            <a href="/forum/forumpost-@forumPost.Id" style="overflow: hidden;display: inline-block;">
                                                @forumPost.Title
                                            </a>
                                        </div>
                                        <div align="right">
                                            @forumPost.ReleaseDate
                                        </div>
                                    </div>

                                    <AuthorizeView Roles="Administrator,User">
                                        @if (CreatedPost(forumPost))
                                        {
                                            <div class="adminButtonsEditRemove" role="group" aria-label="Basic example" style="margin-top: 0.5rem; margin-bottom: 0.9rem;">
                                                <button class="btn btn-danger btn-sm" @onclick="() => OpenPage(forumPost)">Edit</button>
                                                <button class="btn btn-danger btn-sm" @onclick="() => RemovePost(forumPost)">Remove</button>
                                            </div>
                                        }
                                    </AuthorizeView>
                                </div>
                            }



                        }
                        
                    }
                    else
                    {
                        break;
                    }
                    numOfCycles++;
                }
            </div>
        }
    </div>


