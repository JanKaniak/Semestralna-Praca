@page "/news/patchnote-{Id}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using SpaceVoyage.Data
@inject IDbContextFactory<PatchnoteDataContext> PatchnoteDataContextFactory;
@inject NavigationManager NavigationManager


@if (PatchnoteToShow != null) {
    <PageTitle>Patchnote-@PatchnoteToShow.Title</PageTitle>
    <div class="text-post">
        <div class="text-post-header">
            <pre><strong>@PatchnoteToShow.Title</strong></pre>
            <pre>@PatchnoteToShow.ReleaseDate</pre>
        </div>

        <div class="text-post-text">
            <div align="left">
                <pre>@PatchnoteToShow.Description</pre>
            </div>
        </div>

            @if (!string.IsNullOrWhiteSpace(FilePath)) {
                <div class="text-post-image">
                    <img src=@FilePath />
                </div>
            }

            

        
    </div>
}
